{
  "name": "job-scraper-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "job-scraper": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "test": "node --import tsx --test --experimental-test-isolation=none src/**/*.test.ts src/*.test.ts",
    "test:watch": "node --import tsx --test --experimental-test-isolation=none --watch src/**/*.test.ts src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "eslint": "8.57.1",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
